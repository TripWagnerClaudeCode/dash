# Copy to .env and fill in what you want. Everything here is optional —
# the server runs without any of it (tools degrade gracefully).
# .env is git-ignored; never commit real secrets.

# Better web search than the keyless DuckDuckGo default.
# TAVILY_API_KEY=your-tavily-key

# Force a web search provider: auto (default) | tavily | duckduckgo
# WEB_SEARCH_PROVIDER=auto

# Weather defaults.
# WEATHER_UNITS=fahrenheit        # or celsius
# WEATHER_LOCATION=Seattle        # fixed city; omit to auto-detect by IP

# Google (email + calendar). Default paths are ~/.jarvis/credentials.json and
# ~/.jarvis/google_token.json. Override only if you store them elsewhere.
# GOOGLE_CREDENTIALS_PATH=/path/to/credentials.json
# GOOGLE_TOKEN_PATH=/path/to/google_token.json
