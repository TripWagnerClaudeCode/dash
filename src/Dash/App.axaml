<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Dash.Core;assembly=Dash.Core"
             xmlns:views="clr-namespace:Dash.Views"
             xmlns:conv="clr-namespace:Dash.Converters"
             x:Class="Dash.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <conv:RoleBackgroundConverter x:Key="RoleBg"/>
    </Application.Resources>

    <Application.DataTemplates>
        <DataTemplate DataType="core:ChatConversation">
            <views:ChatView/>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
