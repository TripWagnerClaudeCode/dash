<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Dash.Core;assembly=Dash.Core"
             x:Class="Dash.Views.ChatView" x:DataType="core:ChatConversation">
  <DockPanel>
    <!-- Composer -->
    <Border DockPanel.Dock="Bottom" Padding="8" Background="#26262b">
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140"
                 PlaceholderText="Message Dash…  (Return to send, Shift+Return for newline)"
                 KeyDown="OnInputKeyDown"/>
        <Button Grid.Column="1" Margin="8,0,0,0" Content="Stop"
                IsVisible="{Binding IsStreaming}" Click="OnStop"/>
      </Grid>
    </Border>
    <!-- Approval card: shows the full tool input so nothing runs unseen -->
    <Border DockPanel.Dock="Bottom" Margin="16,0,16,8" Padding="12" CornerRadius="8"
            Background="#2a2620" BorderBrush="#c9a227" BorderThickness="1"
            IsVisible="{Binding PendingApproval, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
            <Run Text="Dash wants to use "/><Run Text="{Binding PendingApproval.DisplayName}"/>
          </TextBlock>
          <TextBlock Grid.Column="1" Opacity="0.7"
                     IsVisible="{Binding HasApprovalsWaiting}"
                     Text="{Binding ApprovalsWaiting, StringFormat='+{0} more waiting'}"/>
        </Grid>
        <ScrollViewer MaxHeight="220">
          <SelectableTextBlock Text="{Binding PendingApproval.InputJson}" TextWrapping="Wrap"
                               FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"/>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Deny" Click="OnDeny"/>
          <Button Content="Always allow (this chat)" Click="OnAlwaysAllow"
                  IsVisible="{Binding PendingApproval.CanAlwaysAllow}"/>
          <Button Content="Allow once" Click="OnAllow" Classes="accent"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <!-- Transcript -->
    <ScrollViewer x:Name="Scroll">
      <ItemsControl ItemsSource="{Binding Turns}" Margin="16">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="core:ChatTurn">
            <Border Margin="0,6" Padding="10" CornerRadius="8"
                    Background="{Binding Role, Converter={StaticResource RoleBg}}">
              <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
